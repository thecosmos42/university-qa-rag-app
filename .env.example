# Google Gemini API key — required when EMBEDDING_BACKEND=gemini or using the Gemini LLM.
# Get one at: https://aistudio.google.com/app/apikey
# Add GOOGLE_API_KEY_2, GOOGLE_API_KEY_3, … to enable key rotation on rate limits.
GOOGLE_API_KEY=your_google_api_key_here

# Supabase connection — find these in your Supabase project settings.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# HuggingFace read token — required when EMBEDDING_BACKEND=huggingface.
# Get a free token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Comma-separated list of allowed frontend origins for CORS.
# REQUIRED in production — browser requests will be blocked if not set.
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Set to true to write logs to disk (logs/app.log).
# Leave false/unset on ephemeral platforms (Heroku, Railway, Docker without volumes).
LOG_TO_FILE=false

# Set to true to include internal debug info in /query responses.
# Always leave false in production.
DEBUG_MODE=false
